  {
    "id": "STORAGE-SENSITIVE-LOG",
    "title": "Potential sensitive data in logs",
    "mode": "source",
    "suffixes": [
      ".kt",
      ".java",
      ".swift",
      ".m",
      ".dart",
      ".js",
      ".ts"
    ],
    "pattern": "(?:Log\\.[divew]|print|println|NSLog|console\\.log|logger\\.\\w+)\\s*\\([^\\n]*(?:token|password|secret|email|session)",
    "severity": "high",
    "masvs": "MASVS-STORAGE",
    "remediation": "Remove or redact sensitive values and verify with a unique test canary in a release-equivalent test build.",
    "references": [
      "https://mas.owasp.org/MASVS/controls/MASVS-STORAGE-2/"
    ],
    "mastg_tests": [
      "MASTG-TEST-0231",
      "MASTG-TEST-0297"
    ],
    "maswe": [
      "MASWE-0005"
    ],
    "mapping_scope": "partial: related OWASP test, not a complete implementation of every test step"
  },
