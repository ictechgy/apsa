[
  {
    "id": "WEBVIEW-SSL-BYPASS",
    "title": "WebView TLS error bypass",
    "mode": "source",
    "platform": "android",
    "suffixes": [
      ".kt",
      ".java"
    ],
    "requires": "onReceivedSslError",
    "pattern": "(?:handler|sslErrorHandler)\\s*\\.\\s*proceed\\s*\\(",
    "severity": "high",
    "masvs": "MASVS-NETWORK",
    "remediation": "Cancel TLS errors. Validate the server certificate through the platform trust implementation.",
    "references": [
      "https://developer.android.com/reference/android/webkit/WebViewClient#onReceivedSslError(android.webkit.WebView,%20android.webkit.SslErrorHandler,%20android.net.http.SslError)"
    ],
    "mastg_tests": [
      "MASTG-TEST-0284"
    ],
    "maswe": [
      "MASWE-0027"
    ],
    "mapping_scope": "partial: related OWASP test, not a complete implementation of every test step"
  },
  {
    "id": "WEBVIEW-HOST-MATCH",
    "title": "Substring host validation near WebView or deep-link code",
    "mode": "source",
    "suffixes": [
      ".kt",
      ".java",
      ".swift"
    ],
    "requires": "WebView|WKWebView|intent\\.data|URLComponents",
    "pattern": "(?:host|hostname|url|uri)\\s*(?:\\?\\.)?\\s*\\.?\\s*(?:contains|startsWith|endsWith|hasPrefix|hasSuffix)\\s*\\(",
    "severity": "high",
    "masvs": "MASVS-PLATFORM",
    "remediation": "Parse the URL and validate scheme and exact host, including a dot-boundary check for approved subdomains. Add runtime link cases.",
    "references": [
      "https://developer.android.com/privacy-and-security/risks/unsafe-uri-loading"
    ],
    "mastg_tests": [
      "MASTG-TEST-0332"
    ],
    "maswe": [
      "MASWE-0029",
      "MASWE-0035"
    ],
    "mapping_scope": "partial: related OWASP test, not a complete implementation of every test step"
  },
